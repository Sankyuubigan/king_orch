{
  "productName": "King Orch",
  "version": "26.9.1",
  "identifier": "com.kingorch.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "King Orch - Multi-Agent Studio",
        "width": 1100,
        "height": 850,
        "minWidth": 1100,
        "minHeight": 850,
        "resizable": true,
        "fullscreen": false,
        "additionalBrowserArgs": "--disable-gpu"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "allowDowngrades": true
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "redist/*": "redist/",
      "mcp_servers/*": "mcp_servers/",
      "../agents/": "agents/",
      "../tasks_for_test_llm/": "tasks_for_test_llm/",
      "../models_catalog.json": "models_catalog.json",
      "../sampling_presets.json": "sampling_presets.json"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCMEZGRUE5MUIxQjVGQzUKUldURlh4c2JxZjRQYS9Bc1hUckFGUmoxTnRoNGY1ZytROTRRbTF4T09aUnZCcDlBTzNRTkQydWoK",
      "endpoints": [
        "https://raw.githubusercontent.com/Sankyuubigan/king_orch/main/latest.json"
      ]
    },
    "about-updates": {
      "repo": "Sankyuubigan/king_orch",
      "support_url": "https://interesting-knowledges.vercel.app/docs/otblagodarit-avtora.-pomosch-proektam"
    }
  }
}